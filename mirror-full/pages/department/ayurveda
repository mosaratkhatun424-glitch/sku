    <script>
        var ayushNtsActiveFilter = 'all';

        function ayushNtsFilter(btn, cat) {
            document.querySelectorAll('.ayush-nts-filter-btn').forEach(function (b) { b.classList.remove('active'); });
            btn.classList.add('active');
            ayushNtsActiveFilter = cat;
            document.getElementById('ayush-nts-search').value = '';
            ayushNtsApply('', cat);
        }

        function ayushNtsSearch(val) {
            ayushNtsApply(val, ayushNtsActiveFilter);
        }

        function ayushNtsApply(search, cat) {
            var rows = document.querySelectorAll('#ayush-nts-tbody tr[data-cat]');
            var q = search.toLowerCase().trim();
            var visible = 0;
            rows.forEach(function (row) {
                var catMatch = (cat === 'all') || (row.getAttribute('data-cat') === cat);
                var textMatch = !q || row.textContent.toLowerCase().indexOf(q) !== -1;
                var show = catMatch && textMatch;
                row.classList.toggle('ayush-nts-hidden', !show);
                if (show) visible++;
            });
            document.getElementById('ayush-nts-count').textContent = visible;
            var noRes = document.getElementById('ayush-nts-no-result');
            noRes.classList.toggle('ayush-nts-hidden', visible > 0);
        }
    </script>












    
