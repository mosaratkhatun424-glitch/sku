    <!-- Filter script — no global pollution, uses unique function name -->
    <script>
        function ayushFilter(btn, cat) {
            document.querySelectorAll('.ayush-faculty-filter-btn').forEach(function (b) { b.classList.remove('active'); });
            btn.classList.add('active');

            var rows = document.querySelectorAll('#ayush-faculty-table tbody tr[data-cat]');
            var visible = 0;
            rows.forEach(function (row) {
                var match = (cat === 'all') || (row.getAttribute('data-cat') === cat);
                row.classList.toggle('ayush-faculty-hidden', !match);
                if (match) visible++;
            });

            document.getElementById('ayush-count').textContent = visible;
            var noRes = document.getElementById('ayush-no-result');
            noRes.classList.toggle('ayush-faculty-hidden', visible > 0);
        }
    </script>









