    <script type="text/javascript">
        document.addEventListener('DOMContentLoaded', function () {
            const ejournalMenu = document.querySelector('.e-journal-menu');
            const submenu = ejournalMenu.querySelector('.submenu');
            const ejournalLink = ejournalMenu.querySelector('a');

            // Function to toggle submenu display
            function toggleSubmenu() {
                const isMobileView = window.innerWidth <= 768;

                if (isMobileView) {
                    submenu.style.display = submenu.style.display === 'block' ? 'none' : 'block';
                } else {
                    submenu.style.display = ''; // Reset display for desktop view
                }
            }

            // Toggle submenu on click for mobile
            ejournalLink.addEventListener('click', function (event) {
                const isMobileView = window.innerWidth <= 768;

                if (isMobileView) {
                    event.preventDefault(); // Prevent the default anchor behavior
                    toggleSubmenu();
                }
            });

            // Hide submenu if clicked outside for mobile view
            document.addEventListener('click', function (event) {
                if (window.innerWidth <= 768 && !ejournalMenu.contains(event.target)) {
                    submenu.style.display = 'none';
                }
            });

            // Adjust submenu display on window resize
            window.addEventListener('resize', function () {
                submenu.style.display = ''; // Reset display on resize
            });
        });
    </script>


